{
  "name": "dq-vizlab",
  "version": "1.0.0",
  "description": "DQ Robotics 可视化实验室 - 基于 WebAssembly 的机器人运动学可视化平台",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "benchmark:humanoid-jog": "node tools/run-humanoid-jog-benchmark.mjs",
    "check:nlopt": "sh -c 'if [ -d third_party/nlopt ]; then echo \"✓ NLopt source found at third_party/nlopt\"; else echo \"✗ NLopt source missing at third_party/nlopt\"; echo \"Vendor NLopt before running NLopt-specific builds.\"; exit 1; fi'",
    "build:wasm": "./build.sh",
    "build:wasm:nlopt": "NLOPT_REQUIRED=1 ./build.sh",
    "ros2-backend": "node server/ros2-backend.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run ros2-backend\""
  },
  "keywords": [
    "robotics",
    "dual-quaternion",
    "wasm",
    "webassembly",
    "kinematics",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "numeric": "^1.2.6",
    "rclnodejs": "^1.6.0",
    "three": "^0.160.1",
    "three-stdlib": "^2.36.0",
    "urdf-loader": "^0.12.6",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "playwright": "^1.58.2",
    "vite": "^5.0.0"
  }
}
