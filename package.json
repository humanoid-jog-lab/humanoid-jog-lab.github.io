{
  "name": "humanoid-jog-lab",
  "version": "1.0.0",
  "description": "Humanoid Jog Lab - interactive jog teaching for humanoid upper-body manipulation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "benchmark:humanoid-jog": "node tools/run-humanoid-jog-benchmark.mjs",
    "sample:humanoid-jog": "node tools/run-humanoid-jog-offline-sampler.mjs",
    "plot:humanoid-jog": "node tools/plot-humanoid-jog-data.mjs",
    "collect:ral-evidence": "node tools/collect-ral-paper-evidence.mjs",
    "build:wasm": "./build.sh",
    "ros2-backend": "node server/ros2-backend.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run ros2-backend\""
  },
  "keywords": [
    "robotics",
    "dual-quaternion",
    "wasm",
    "webassembly",
    "kinematics",
    "visualization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "numeric": "^1.2.6",
    "rclnodejs": "^1.6.0",
    "three": "^0.160.1",
    "three-stdlib": "^2.36.0",
    "urdf-loader": "^0.12.6",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "playwright": "^1.58.2",
    "vite": "^5.0.0"
  }
}
